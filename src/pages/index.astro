---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ConocePelechuco from '../components/ConocePelechuco.astro';
import Galeria from '../components/Galeria.astro';
import NoticiasSection from '../components/NoticiasSection.astro';
import AutoridadesSection from '../components/AutoridadesSection.astro';
import TramitesSection from '../components/TramitesSection.astro';
import ContactoSection from '../components/ContactoSection.astro';
import Footer from '../components/Footer.astro';

import { supabase, isSupabaseConfigured } from '../lib/supabase';
import {
  getDefaultPortalData,
  DEFAULT_NOTICIAS,
  DEFAULT_CATEGORIAS_NOTICIAS,
  DEFAULT_TRAMITES,
} from '../lib/data-defaults';

export const prerender = false;

let portalData = getDefaultPortalData();
let noticias = DEFAULT_NOTICIAS;
let categoriasNoticias = DEFAULT_CATEGORIAS_NOTICIAS;
let tramites = DEFAULT_TRAMITES;

if (isSupabaseConfigured()) {
  try {
    const { data: viewData, error: viewError } = await supabase
      .from('v_portal_publico')
      .select('*')
      .single();

    if (!viewError && viewData) {
      portalData = viewData;
    } else {
      const { data: introData } = await supabase.from('conoce_intro').select('*').single();
      if (introData) portalData.conoce_intro = introData;
    }

    const { data: noticiasData } = await supabase
      .from('noticias')
      .select('*, category:noticias_categorias(*)')
      .eq('status', 'publicado')
      .order('published_at', { ascending: false })
      .limit(7);

    if (noticiasData && noticiasData.length > 0) {
      noticias = noticiasData;
    }

    const { data: catData } = await supabase
      .from('noticias_categorias')
      .select('*')
      .eq('is_active', true)
      .order('display_order');

    if (catData && catData.length > 0) {
      categoriasNoticias = catData;
    }

    const { data: tramData } = await supabase
      .from('tramites')
      .select('*')
      .eq('is_active', true)
      .order('display_order');

    if (tramData && tramData.length > 0) {
      tramites = tramData.map(item => {
        const def = DEFAULT_TRAMITES.find(d => d.id === item.id || d.slug === item.slug);
        return {
          ...def,
          ...item,
          image_url: item.image_url ?? def?.image_url ?? null,
          video_url: item.video_url ?? def?.video_url ?? null,
          document_url: item.document_url ?? def?.document_url ?? null,
          document_name: item.document_name ?? def?.document_name ?? null,
        };
      });
    }
  } catch (err) {
    console.warn('Usando datos por defecto:', err);
  }
}
---

<BaseLayout>
  <Header />

  <main id="main-content">
    <Hero data={portalData.hero} />
    <NoticiasSection noticias={noticias} categorias={categoriasNoticias} />
    <ConocePelechuco intro={portalData.conoce_intro} secciones={portalData.conoce_secciones} />
    <Galeria imagenes={portalData.galeria} />
    <AutoridadesSection autoridades={portalData.autoridades} />
    <TramitesSection tramites={tramites} categorias={portalData.tramites_categorias} />
    <ContactoSection contacto={portalData.contacto} />
  </main>

  <Footer contacto={portalData.contacto} redes={portalData.redes_sociales} />
</BaseLayout>

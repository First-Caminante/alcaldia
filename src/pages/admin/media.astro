      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1rem;border-bottom:1px solid #e2e8f0;padding-bottom:0.75rem;">
        <h3 id="lightbox-titulo" style="font-size:1.1rem;font-weight:700;color:#0f172a;margin:0;max-width:85%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
          Vista Previa de Imagen
        </h3>
        <button type="button" id="lightbox-cerrar" style="background:none;border:none;font-size:1.3rem;cursor:pointer;color:#64748b;">✕</button>

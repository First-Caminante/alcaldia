  <!-- Modal para Subir Archivo a Supabase Storage -->
  <div id="modal-subida-r2" class="admin-modal-backdrop" style="display:none;">
    <div class="admin-modal-card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:1.25rem;border-bottom:1px solid #e2e8f0;padding-bottom:0.75rem;">
        <h3 style="font-size:1.2rem;font-weight:700;color:#0f172a;margin:0;">
          Subir a Supabase Storage
        </h3>
        <button type="button" id="modal-subida-cerrar" style="background:none;border:none;font-size:1.25rem;cursor:pointer;color:#64748b;">✕</button>
      </div>

      <form id="form-subida-r2" style="display:flex;flex-direction:column;gap:1.2rem;">
        <div>
          <label style="display:block;font-size:0.8rem;font-weight:600;color:#475569;margin-bottom:0.25rem;">Carpeta de destino *</label>
          <select id="subida-folder" required style="width:100%;padding:0.6rem 0.8rem;border:1px solid #cbd5e1;border-radius:6px;font-size:0.875rem;">
            <option value="noticias">noticias/ (Comunicados y novedades)</option>
            <option value="galeria">galeria/ (Fotografías del municipio)</option>
            <option value="autoridades">autoridades/ (Fotos de concejales y alcalde)</option>
            <option value="hero">hero/ (Fondos de portada)</option>
            <option value="tramites">tramites/ (Formularios y PDF de servicios)</option>
            <option value="conoce">conoce/ (Imágenes de turismo y atractivos)</option>
            <option value="general">general/ (Otros recursos institucionales)</option>
          </select>
        </div>

        <div>
          <label style="display:block;font-size:0.8rem;font-weight:600;color:#475569;margin-bottom:0.25rem;">Seleccionar archivo local *</label>
          <input type="file" id="subida-archivo" required style="width:100%;padding:0.6rem 0.8rem;border:1px dashed #94a3b8;border-radius:6px;background:#f8fafc;" accept="image/*,application/pdf" />
          <small style="color:#64748b;font-size:0.75rem;margin-top:0.25rem;display:block;">⚡ Las imágenes se optimizarán a formato WebP automáticamente antes de enviarse para ahorrar espacio.</small>
        </div>

        <div id="subida-status" style="font-size:0.8rem;display:none;padding:0.6rem 0.8rem;border-radius:6px;"></div>

        <div style="display:flex;justify-content:flex-end;gap:0.75rem;margin-top:0.5rem;border-top:1px solid #e2e8f0;padding-top:1rem;">
          <button type="button" id="modal-subida-cancelar" style="background:#f1f5f9;color:#475569;border:1px solid #cbd5e1;padding:0.6rem 1.2rem;border-radius:6px;cursor:pointer;font-weight:600;">
            Cancelar
          </button>
          <button type="submit" id="btn-subir-submit" style="background:#2D5016;color:#FAF7F2;border:none;padding:0.6rem 1.5rem;border-radius:6px;cursor:pointer;font-weight:600;">
            Optimizar y Subir
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    function initMedia() {
      // Elementos del DOM
      const modal = document.getElementById('modal-subida-r2');
      const btnAbrir = document.getElementById('btn-abrir-subida');
      const btnEmptySubir = document.getElementById('btn-empty-subir');
      const btnCerrar = document.getElementById('modal-subida-cerrar');
      const btnCancelar = document.getElementById('modal-subida-cancelar');
      const form = document.getElementById('form-subida-r2') as HTMLFormElement | null;
      const statusDiv = document.getElementById('subida-status');
      const submitBtn = document.getElementById('btn-subir-submit') as HTMLButtonElement | null;
      const fileInput = document.getElementById('subida-archivo') as HTMLInputElement | null;
      const folderSelect = document.getElementById('subida-folder') as HTMLSelectElement | null;
      const btnSync = document.getElementById('btn-sync-media');

      // Vistas y filtros
      const btnVistaGrid = document.getElementById('btn-vista-grid');
      const btnVistaTabla = document.getElementById('btn-vista-tabla');
      const vistaGrid = document.getElementById('contenedor-vista-grid');
      const vistaTabla = document.getElementById('contenedor-vista-tabla');
      const mediaGrid = document.getElementById('media-grid');
      const tablaBody = document.getElementById('tabla-media-body');
      const searchInput = document.getElementById('search-media') as HTMLInputElement | null;
      const sourceUsageSelect = document.getElementById('filter-source-usage') as HTMLSelectElement | null;
      const sortSelect = document.getElementById('sort-media') as HTMLSelectElement | null;
      const filterBtns = document.querySelectorAll('.filter-btn');
      const storageFolderChips = document.querySelectorAll('.storage-folder-chip');

      // Lightbox
      const lightboxModal = document.getElementById('modal-lightbox');
      const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
      const lightboxTitulo = document.getElementById('lightbox-titulo');
      const lightboxUrlTxt = document.getElementById('lightbox-url-txt');
      const lightboxBtnCopiar = document.getElementById('lightbox-btn-copiar');
      const lightboxBtnAbrir = document.getElementById('lightbox-btn-abrir') as HTMLAnchorElement | null;
      const lightboxCerrar = document.getElementById('lightbox-cerrar');

      // Modal de subida
      function openModal() {
        if (!modal) return;
        modal.classList.add('open');
        modal.style.display = 'flex';
        if (statusDiv) statusDiv.style.display = 'none';
        form?.reset();
        if (folderSelect && activeFolder !== 'all') {
          folderSelect.value = activeFolder;
        }
      }

      function closeModal() {
        if (!modal) return;
        modal.classList.remove('open');
        modal.style.display = 'none';
        form?.reset();
      }

      btnAbrir?.addEventListener('click', openModal);
      btnEmptySubir?.addEventListener('click', openModal);
      btnCerrar?.addEventListener('click', closeModal);
      btnCancelar?.addEventListener('click', closeModal);

      // Alternar vistas (Cuadrícula vs Tabla)
      btnVistaGrid?.addEventListener('click', () => {
        if (!vistaGrid || !vistaTabla || !btnVistaGrid || !btnVistaTabla) return;
        vistaGrid.style.display = 'block';
        vistaTabla.style.display = 'none';
        btnVistaGrid.classList.add('active');
        btnVistaTabla.classList.remove('active');
      });

      btnVistaTabla?.addEventListener('click', () => {
        if (!vistaGrid || !vistaTabla || !btnVistaGrid || !btnVistaTabla) return;
        vistaGrid.style.display = 'none';
        vistaTabla.style.display = 'block';
        btnVistaTabla.classList.add('active');
        btnVistaGrid.classList.remove('active');
      });

      // Filtro de carpeta, origen/uso, búsqueda y ordenamiento
      let activeFolder = 'all';
      let activeSourceUsage = 'all';
      let searchTerm = '';

      function setActiveFolder(folder: string) {
        activeFolder = folder || 'all';
        filterBtns.forEach(b => {
          b.classList.toggle('active', b.getAttribute('data-folder') === activeFolder);
        });
        applyFilters();
      }

      function applyFilters() {
        const gridItems = document.querySelectorAll('.media-card-item');
        const tableRows = document.querySelectorAll('.media-table-row');

        const matchesItem = (el: Element) => {
          const itemFolders = (el.getAttribute('data-folders') || el.getAttribute('data-folder') || '').split(' ').filter(Boolean);
          const itemSource = el.getAttribute('data-source') || '';
          const itemUsed = el.getAttribute('data-used') === 'true';
          const itemSearch = el.getAttribute('data-search') || el.getAttribute('data-name') || '';

          const matchFolder = activeFolder === 'all' || itemFolders.includes(activeFolder);
          const matchSearch = !searchTerm || itemSearch.includes(searchTerm);
          let matchSourceUsage = true;
          if (activeSourceUsage === 'storage') matchSourceUsage = itemSource === 'storage';
          else if (activeSourceUsage === 'external') matchSourceUsage = itemSource === 'external';
          else if (activeSourceUsage === 'used') matchSourceUsage = itemUsed;
          else if (activeSourceUsage === 'unused') matchSourceUsage = !itemUsed;

          return matchFolder && matchSearch && matchSourceUsage;
        };

        gridItems.forEach((el) => {
          el.classList.toggle('is-hidden-media', !matchesItem(el));
        });

        tableRows.forEach((el) => {
          el.classList.toggle('is-hidden-media', !matchesItem(el));
        });
      }

      function applySort() {
        const mode = sortSelect?.value || 'folder-usage';
        const compareEls = (a: Element, b: Element) => {
          if (mode === 'recent') {
            const diff = Number(b.getAttribute('data-created') || '0') - Number(a.getAttribute('data-created') || '0');
            if (diff !== 0) return diff;
          } else if (mode === 'name-asc') {
            return (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '');
          } else if (mode === 'size-desc') {
            const diff = Number(b.getAttribute('data-size') || '0') - Number(a.getAttribute('data-size') || '0');
            if (diff !== 0) return diff;
          }
          // Default: folder-usage
          const fDiff = Number(a.getAttribute('data-folder-order') || '9') - Number(b.getAttribute('data-folder-order') || '9');
          if (fDiff !== 0) return fDiff;
          const uDiff = (b.getAttribute('data-used') === 'true' ? 1 : 0) - (a.getAttribute('data-used') === 'true' ? 1 : 0);
          if (uDiff !== 0) return uDiff;
          return Number(b.getAttribute('data-created') || '0') - Number(a.getAttribute('data-created') || '0');
        };

        if (mediaGrid) {
          Array.from(mediaGrid.querySelectorAll('.media-card-item'))
            .sort(compareEls)
            .forEach(el => mediaGrid.appendChild(el));
        }
        if (tablaBody) {
          Array.from(tablaBody.querySelectorAll('.media-table-row'))
            .sort(compareEls)
            .forEach(el => tablaBody.appendChild(el));
        }
      }

      filterBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          setActiveFolder(btn.getAttribute('data-folder') || 'all');
        });
      });

      storageFolderChips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const targetFolder = chip.getAttribute('data-jump-folder') || 'all';
          setActiveFolder(targetFolder);
        });
      });

      sourceUsageSelect?.addEventListener('change', () => {
        activeSourceUsage = sourceUsageSelect.value || 'all';
        applyFilters();
      });

      sortSelect?.addEventListener('change', applySort);

      searchInput?.addEventListener('input', (e) => {
        searchTerm = (e.target as HTMLInputElement).value.toLowerCase().trim();
        applyFilters();
      });

      const initialFolderParam = new URLSearchParams(window.location.search).get('folder');
      if (initialFolderParam) {
        setActiveFolder(initialFolderParam);
      }

      // Lightbox preview
      function openLightbox(url: string, title: string) {
        if (!lightboxModal || !lightboxImg) return;
        lightboxImg.src = url;
        if (lightboxTitulo) lightboxTitulo.textContent = title || 'Vista Previa';
        if (lightboxUrlTxt) lightboxUrlTxt.textContent = url;
        if (lightboxBtnAbrir) lightboxBtnAbrir.href = url;
        lightboxModal.classList.add('open');
        lightboxModal.style.display = 'flex';
      }

      function closeLightbox() {
        if (!lightboxModal) return;
        lightboxModal.classList.remove('open');
        lightboxModal.style.display = 'none';
        if (lightboxImg) lightboxImg.src = '';
      }

      lightboxCerrar?.addEventListener('click', closeLightbox);
      lightboxModal?.addEventListener('click', (e) => {
        if (e.target === lightboxModal) closeLightbox();
      });

      lightboxBtnCopiar?.addEventListener('click', () => {
        const url = lightboxImg?.src;
        if (url) {
          navigator.clipboard.writeText(url).then(() => {
            if ((window as any).showToast) {
              (window as any).showToast('URL copiada al portapapeles');
            } else {
              alert('URL copiada: ' + url);
            }
          });
        }
      });

      // Botón Sincronizar Almacenamiento
      btnSync?.addEventListener('click', async () => {
        if (btnSync) {
          btnSync.setAttribute('disabled', 'true');
          btnSync.innerHTML = '<span>⏳</span> Sincronizando...';
        }
        try {
          const adminFetch = (window as any).adminFetch || fetch;
          const res = await adminFetch('/api/admin/media/sync', { method: 'POST' });
          const data = await res.json();
          if (res.ok && data.success) {
            if ((window as any).showToast) {
              (window as any).showToast(`Sincronización completada: ${data.totalCount} archivos disponibles`);
            }
            setTimeout(() => window.location.reload(), 1000);
          } else {
            alert(data.error || 'Error al sincronizar');
          }
        } catch (err: any) {
          alert('Error de conexión al sincronizar: ' + err.message);
        } finally {
          if (btnSync) {
            btnSync.removeAttribute('disabled');
            btnSync.innerHTML = '<span>🔄</span> Sincronizar Almacenamiento';
          }
        }
      });

      // Delegación de clics: Copiar URL, Eliminar y Abrir Lightbox
      document.addEventListener('click', async (e) => {
        const target = e.target as HTMLElement;

        // Abrir Lightbox al hacer click en la miniatura de la card
        const thumbContainer = target.closest('.media-thumb-container');
        if (thumbContainer) {
          const img = thumbContainer.querySelector('img');
          if (img && img.src) {
            const card = target.closest('.media-card-item');
            const name = card?.getAttribute('data-name') || 'Imagen';
            openLightbox(img.src, name);
            return;
          }
        }

        // Abrir Lightbox al hacer click en la miniatura de la tabla
        if (target.classList.contains('table-thumb-preview')) {
          const url = target.getAttribute('data-url');
          if (url) openLightbox(url, 'Imagen');
          return;
        }

        // Copiar URL al portapapeles
        const copyBtn = target.closest('.btn-copiar-url');
        if (copyBtn) {
          const url = copyBtn.getAttribute('data-url');
          if (url) {
            navigator.clipboard.writeText(url).then(() => {
              if ((window as any).showToast) {
                (window as any).showToast('URL copiada al portapapeles');
              } else {
                alert('URL copiada: ' + url);
              }
            });
          }
          return;
        }

        // Eliminar archivo
        const deleteBtn = target.closest('.btn-eliminar-media');
        if (deleteBtn) {
          const id = deleteBtn.getAttribute('data-id');
          const name = deleteBtn.getAttribute('data-name') || 'este archivo';
          const usage = deleteBtn.getAttribute('data-usage') || '';
          if (!id) return;

          const confirmMsg = usage
            ? `⚠️ "${name}" se está usando actualmente en:\n${usage}\n\n¿Seguro que desea eliminarlo de Supabase Storage y de la base de datos?`
            : `¿Está seguro de eliminar "${name}" de Supabase Storage y de la base de datos?`;
          if (!confirm(confirmMsg)) {
            return;
          }

          try {
            const adminFetch = (window as any).adminFetch || fetch;
            const res = await adminFetch(`/api/admin/media/${id}`, {
              method: 'DELETE'
            });
            const data = await res.json();
            if (res.ok && data.success) {
              if ((window as any).showToast) {
                (window as any).showToast('Archivo eliminado exitosamente');
              }
              setTimeout(() => window.location.reload(), 550);
            } else {
              alert(data.error || 'No se pudo eliminar el archivo');
            }
          } catch (err: any) {
            alert('Error al intentar eliminar el archivo: ' + err.message);
          }
        }
      });

      // Envío de formulario de subida con optimización automática a WebP
      form?.addEventListener('submit', async (e) => {
        e.preventDefault();
        const rawFile = fileInput?.files?.[0];
        const folder = folderSelect?.value || 'general';

        if (!rawFile) {
          alert('Por favor seleccione un archivo');
          return;
        }

        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = 'Procesando archivo...';
        }

        if (statusDiv) {
          statusDiv.style.display = 'block';
          statusDiv.style.background = '#eff6ff';
          statusDiv.style.color = '#1d4ed8';
          statusDiv.style.border = '1px solid #bfdbfe';
          statusDiv.textContent = '⚡ Optimizando imagen y convirtiendo a WebP...';
        }

        try {
          const optimizer = (window as any).optimizeImageToWebP;
          let fileToUpload = rawFile;
          let statsMsg = '';

          if (optimizer && rawFile.type.startsWith('image/')) {
            const { file: optFile, originalSize, optimizedSize, savedPercent } = await optimizer(rawFile, {
              maxWidth: 1400,
              maxHeight: 1400,
              quality: 0.82
            });
            fileToUpload = optFile;
            if (savedPercent > 0) {
              statsMsg = ` (Ahorro: ${(originalSize/1024).toFixed(0)}KB ➔ ${(optimizedSize/1024).toFixed(0)}KB, -${savedPercent}%)`;
            }
          }

          if (statusDiv) {
            statusDiv.textContent = `⏳ Subiendo a Supabase Storage${statsMsg}...`;
          }

          const formData = new FormData();
          formData.append('file', fileToUpload);
          formData.append('folder', folder);

          const adminFetch = (window as any).adminFetch || fetch;
          const res = await adminFetch('/api/admin/upload', {
            method: 'POST',
            body: formData
          });

          const data = await res.json();
          if (res.ok && data.success) {
            if (statusDiv) {
              statusDiv.style.background = '#f0fdf4';
              statusDiv.style.color = '#15803d';
              statusDiv.style.border = '1px solid #bbf7d0';
              statusDiv.textContent = `✅ Archivo guardado con éxito: ${data.fileName}${statsMsg}`;
            }
            if ((window as any).showToast) {
              (window as any).showToast('Archivo subido exitosamente');
            }
            setTimeout(() => {
              window.location.href = `/admin/media?folder=${encodeURIComponent(folder)}`;
            }, 900);
          } else {
            if (statusDiv) {
              statusDiv.style.background = '#fef2f2';
              statusDiv.style.color = '#b91c1c';
              statusDiv.style.border = '1px solid #fecaca';
              statusDiv.textContent = `❌ ${data.error || 'Ocurrió un error al subir el archivo'}`;
            }
          }
        } catch (err: any) {
          if (statusDiv) {
            statusDiv.style.background = '#fef2f2';
            statusDiv.style.color = '#b91c1c';
            statusDiv.style.border = '1px solid #fecaca';
            statusDiv.textContent = '❌ Error de conexión al subir el archivo: ' + err.message;
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = 'Optimizar y Subir';
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMedia);
    } else {
      initMedia();
    }
  </script>
</AdminLayout>

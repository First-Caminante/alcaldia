---
import type { Noticia, NoticiaCategoria } from '../types/database';
import NoticiaCard from './NoticiaCard.astro';
import { getYouTubeEmbedUrl } from '../lib/youtube';

interface Props {
  noticias: Noticia[];
  categorias?: NoticiaCategoria[];
}

const { noticias = [], categorias = [] } = Astro.props;

// La noticia más reciente (noticias[0]) tiene la máxima prioridad y se muestra en formato horizontal destacado
const noticiaPrincipal = noticias.length > 0 ? noticias[0] : null;
const noticiasRestantes = noticias.length > 1 ? noticias.slice(1) : [];

const youtubeEmbedUrl = noticiaPrincipal?.video_url ? getYouTubeEmbedUrl(noticiaPrincipal.video_url) : null;
const principalImages: string[] = [
  noticiaPrincipal?.featured_image_url,
  ...(Array.isArray(noticiaPrincipal?.gallery_images) ? noticiaPrincipal.gallery_images : [])
].filter((url): url is string => Boolean(url && typeof url === 'string' && url.trim()));
const principalHasMultiple = principalImages.length > 1;
const fotosGaleriaCount = Array.isArray(noticiaPrincipal?.gallery_images) ? noticiaPrincipal.gallery_images.length : 0;

function formatDate(dateStr: string) {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('es-BO', {
      day: 'numeric',
      month: 'long',
      year: 'numeric'
    });
  } catch {
    return dateStr;
  }
}
---

<section id="noticias" aria-labelledby="noticias-titulo" class="p02-section-alt">
  <div class="p02-section">
    <p class="p02-section-label">Comunicación institucional</p>
    <h2 class="p02-section-title" id="noticias-titulo">Noticias y Comunicados Oficiales</h2>
    <div class="p02-section-title-deco" aria-hidden="true"></div>

    <p style="text-align:center;max-width:680px;margin:0 auto 1.75rem;color:var(--text-muted);font-size:0.95rem;line-height:1.6;">
      Gacetas municipales, convocatorias públicas, avances de obras y comunicados oficiales del Gobierno Autónomo Municipal de Pelechuco.
    </p>

    <!-- Buscador interactivo -->
    <div class="busqueda-wrap" style="max-width:560px;margin:0 auto 1.5rem;">
      <input
        type="search"
        id="busqueda-noticias"
        class="busqueda-input"
        placeholder="Buscar comunicados por título o palabra clave..."
        aria-label="Buscar noticias"
      />
    </div>

    <!-- Filtros de categoría -->
    <div class="filtros-wrap" id="filtros-categorias" role="group" aria-label="Filtrar por categoría" style="display:flex;justify-content:center;gap:0.5rem;flex-wrap:wrap;margin-bottom:2.25rem;">
      <button class="filtro-btn active" data-category="todos">Todos los comunicados</button>
      {categorias.map(cat => (
        <button class="filtro-btn" data-category={cat.slug}>{cat.name}</button>
      ))}
    </div>

    <!-- 1. NOTICIA PRINCIPAL / DESTACADA (HORIZONTAL 16:9 LIMPIO Y ELEGANTE) -->
    {noticiaPrincipal && (
      <article
        class="noticia-card noticia-card-principal"
        data-slug={noticiaPrincipal.slug}
        data-category={noticiaPrincipal.category?.slug || 'obras'}
        aria-label={`Noticia principal destacada: ${noticiaPrincipal.title}`}
      >
        <!-- Marco de Medios Horizontal 16:9 (Video de YouTube Oficial o Fotografía 16:9) -->
        <div class="noticia-principal-media">
          {youtubeEmbedUrl ? (
            <iframe
              src={youtubeEmbedUrl}
              title={`Video oficial: ${noticiaPrincipal.title}`}
              class="noticia-principal-iframe"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
              allowfullscreen
              loading="lazy"
            ></iframe>
          ) : principalHasMultiple ? (
            <div class="card-carousel-container noticia-principal-carousel" data-total={principalImages.length}>
              {principalImages.map((imgUrl, idx) => (
                <img
                  src={imgUrl}
                  alt={`${noticiaPrincipal.title} — Foto ${idx + 1}`}
                  loading={idx === 0 ? "eager" : "lazy"}
                  class={`card-carousel-img noticia-principal-carousel-img ${idx === 0 ? 'active' : ''}`}
                  data-index={idx}
                  onerror="this.src='https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1200&q=80';"
                />
              ))}

              <!-- Controles de navegación de fotos -->
              <button type="button" class="card-carousel-arrow prev" aria-label="Foto anterior" title="Foto anterior">
                ‹
              </button>
              <button type="button" class="card-carousel-arrow next" aria-label="Siguiente foto" title="Siguiente foto">
                ›
              </button>

              <!-- Indicador de puntos interactivo -->
              <div class="card-carousel-dots" role="tablist" aria-label="Fotografías de la noticia principal">
                {principalImages.map((_, idx) => (
                  <button
                    type="button"
                    class={`card-carousel-dot ${idx === 0 ? 'active' : ''}`}
                    data-dot={idx}
                    aria-label={`Ver foto ${idx + 1}`}
                  ></button>
                ))}
              </div>

              <!-- Contador de fotos -->
              <span class="card-carousel-counter">
                📸 <span class="counter-curr">1</span>/{principalImages.length}
              </span>
            </div>
          ) : (
            <img
              src={noticiaPrincipal.featured_image_url}
              alt={noticiaPrincipal.featured_image_alt || noticiaPrincipal.title}
              class="noticia-principal-img"
              loading="eager"
              fetchpriority="high"
              onerror="this.src='https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=1200&q=80';"
            />
          )}

          <!-- Insignias flotantes sobre el medio -->
          <div class="noticia-principal-badges">
            <span class="badge-reciente">
              <span class="badge-pulse-dot" aria-hidden="true"></span>
              {youtubeEmbedUrl ? '🎬 VIDEO OFICIAL RECIENTE' : 'ÚLTIMO COMUNICADO OFICIAL'}
            </span>
            {noticiaPrincipal.category && (
              <span class="badge-category">
                {noticiaPrincipal.category.name}
              </span>
            )}
          </div>
        </div>

        <!-- Contenido Editorial Limpio y Espacioso -->
        <div class="noticia-principal-body">
          <div class="noticia-principal-meta-bar">
            <span class="meta-item meta-fecha">
              📅 {formatDate(noticiaPrincipal.published_at)}
            </span>
            <span class="meta-sep" aria-hidden="true">·</span>
            <span class="meta-item meta-origen">
              🏛️ GAM Pelechuco · Despacho Oficial
            </span>
            {fotosGaleriaCount > 0 && (
              <>
                <span class="meta-sep" aria-hidden="true">·</span>
                <span class="badge-fotos-disponibles" style="background:var(--bg-alt);color:var(--primary);padding:0.2rem 0.65rem;border-radius:12px;font-size:0.75rem;font-weight:600;border:1px solid var(--border);">
                  📸 Galería de {fotosGaleriaCount + 1} fotos disponible al ver más
                </span>
              </>
            )}
          </div>

          <h3 class="noticia-principal-title">
            <a href={`/noticias/${noticiaPrincipal.slug}`}>
              {noticiaPrincipal.title}
            </a>
          </h3>

          <p class="noticia-principal-summary">
            {noticiaPrincipal.summary}
          </p>

          <div class="noticia-principal-footer">
            <a
              href={`/noticias/${noticiaPrincipal.slug}`}
              class="btn-leer-destacada"
              aria-label={`Leer comunicado completo: ${noticiaPrincipal.title}`}
            >
              <span>Leer comunicado completo oficial</span>
              <span class="arrow-icon" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </article>
    )}

    <!-- 2. PUBLICACIONES SECUNDARIAS (GACETAS Y COMUNICADOS EN CUADRÍCULA) -->
    {noticiasRestantes.length > 0 && (
      <div id="seccion-noticias-secundarias">
        <div class="noticias-secundarias-header">
          <div class="secundarias-header-left">
            <span class="secundarias-icon">📰</span>
            <h3 class="secundarias-title">Más Comunicados y Gacetas Recientes</h3>
          </div>
          <span class="secundarias-count" id="secundarias-count-label">
            {noticiasRestantes.length} publicaciones
          </span>
        </div>

        <!-- Grid de noticias restantes -->
        <div class="p02-noticias-grid" id="lista-noticias" aria-live="polite" aria-label="Lista de noticias secundarias">
          {noticiasRestantes.map(noticia => (
            <NoticiaCard noticia={noticia} />
          ))}
        </div>
      </div>
    )}

    <!-- Estado vacío interactivo si la búsqueda no encuentra nada -->
    <div id="noticias-vacio" style="display:none;text-align:center;padding:3rem 1rem;color:var(--text-muted);">
      <div style="font-size:2.5rem;margin-bottom:0.75rem;">🔍</div>
      <p style="font-size:1.15rem;font-weight:600;margin-bottom:0.5rem;color:var(--text);">No se encontraron comunicados con ese criterio.</p>
      <p style="font-size:0.9rem;margin-bottom:1.25rem;">Intente buscar con otra palabra clave o seleccione "Todos los comunicados".</p>
      <button id="reset-filtros-btn" class="p02-btn-outline" style="font-size:0.85rem;padding:0.45rem 1.2rem;cursor:pointer;">
        Restablecer filtros
      </button>
    </div>
  </div>
</section>

<style>
  /* ── Estilos de la Noticia Principal Destacada (16:9 Horizontal Limpio) ── */
  .noticia-card-principal {
    max-width: 960px;
    margin: 0 auto 2.75rem;
    background: var(--card-bg, #F4EFE2);
    border: 1px solid var(--border-light, #D8CDAF);
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.07);
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
    display: flex;
    flex-direction: column;
  }

  .noticia-card-principal:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(45, 80, 22, 0.15);
    border-color: var(--primary);
  }

  /* Marco de Imagen Horizontal Widescreen 16:9 */
  .noticia-principal-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 480px;
    overflow: hidden;
    background: #0f1824;
  }

  .noticia-principal-img,
  .noticia-principal-iframe {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    border: none;
    display: block;
  }

  .noticia-principal-img {
    object-fit: cover;
    object-position: center;
    transition: transform 0.45s ease;
  }

  .noticia-card-principal:hover .noticia-principal-img {
    transform: scale(1.02);
  }

  /* Carrusel en noticia principal cuando no hay video */
  .noticia-principal-carousel {
    position: relative;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .noticia-principal-carousel-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transform: scale(1.05);
    transition: opacity 0.85s cubic-bezier(0.4, 0, 0.2, 1), transform 1.2s ease-out;
    pointer-events: none;
    will-change: opacity, transform;
  }

  .noticia-principal-carousel-img.active {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  .noticia-card-principal:hover .noticia-principal-carousel-img.active {
    transform: scale(1.02);
  }

  .noticia-principal-carousel .card-carousel-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(15, 23, 42, 0.72);
    color: #FAF7F2;
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 50%;
    width: 38px;
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: bold;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.25s ease, background 0.2s ease, transform 0.15s ease;
    z-index: 5;
    user-select: none;
    line-height: 1;
    padding: 0;
    padding-bottom: 3px;
    backdrop-filter: blur(4px);
  }

  .noticia-card-principal:hover .card-carousel-arrow,
  .noticia-card-principal:focus-within .card-carousel-arrow {
    opacity: 1;
  }

  .noticia-principal-carousel .card-carousel-arrow:hover {
    background: rgba(45, 80, 22, 0.95);
    border-color: rgba(255, 255, 255, 0.45);
    transform: translateY(-50%) scale(1.1);
  }

  .noticia-principal-carousel .card-carousel-arrow.prev { left: 1rem; }
  .noticia-principal-carousel .card-carousel-arrow.next { right: 1rem; }

  .noticia-principal-carousel .card-carousel-dots {
    position: absolute;
    bottom: 0.85rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 5;
    align-items: center;
    background: rgba(15, 23, 42, 0.5);
    padding: 4px 9px;
    border-radius: 9999px;
    backdrop-filter: blur(4px);
  }

  .noticia-principal-carousel .card-carousel-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: none;
    padding: 0;
    background: rgba(255, 255, 255, 0.45);
    cursor: pointer;
    transition: background 0.3s ease, transform 0.3s ease, width 0.3s ease;
  }

  .noticia-principal-carousel .card-carousel-dot.active {
    background: #FAF7F2;
    width: 20px;
    border-radius: 4px;
  }

  .noticia-principal-carousel .card-carousel-counter {
    position: absolute;
    bottom: 0.85rem;
    right: 1rem;
    background: rgba(15, 23, 42, 0.75);
    color: #FAF7F2;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    backdrop-filter: blur(4px);
    z-index: 5;
    pointer-events: none;
  }

  /* Insignias sobre la imagen horizontal */
  .noticia-principal-badges {
    position: absolute;
    top: 1.1rem;
    left: 1.1rem;
    right: 1.1rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    pointer-events: none;
  }

  .badge-reciente {
    background: rgba(45, 80, 22, 0.94);
    color: #FAF7F2;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
  }

  .badge-pulse-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #ef4444;
    box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    animation: pulse-dot 1.8s infinite;
  }

  @keyframes pulse-dot {
    0% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7);
    }
    70% {
      box-shadow: 0 0 0 9px rgba(239, 68, 68, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(239, 68, 68, 0);
    }
  }

  .badge-category {
    background: rgba(196, 168, 130, 0.96);
    color: #1A3008;
    font-weight: 700;
    font-size: 0.78rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(255, 255, 255, 0.35);
  }

  /* Cuerpo Editorial */
  .noticia-principal-body {
    padding: 2rem 2.25rem 2.25rem;
    display: flex;
    flex-direction: column;
  }

  @media (max-width: 640px) {
    .noticia-principal-body {
      padding: 1.35rem 1.15rem 1.5rem;
    }
  }

  .noticia-principal-meta-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }

  .meta-fecha {
    font-weight: 600;
  }

  .meta-sep {
    opacity: 0.6;
  }

  .meta-origen {
    font-weight: 500;
  }

  .noticia-principal-title {
    font-size: clamp(1.45rem, 2.6vw, 2.05rem);
    font-weight: 800;
    line-height: 1.3;
    color: var(--text);
    margin: 0 0 1rem 0;
  }

  .noticia-principal-title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .noticia-principal-title a:hover {
    color: var(--primary);
  }

  .noticia-principal-summary {
    font-size: 1.025rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin: 0 0 1.65rem 0;
  }

  .noticia-principal-footer {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: auto;
  }

  .btn-leer-destacada {
    background: var(--primary);
    color: #FAF7F2 !important;
    font-weight: 700;
    font-size: 0.95rem;
    padding: 0.8rem 1.6rem;
    border-radius: 8px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    box-shadow: 0 4px 14px rgba(45, 80, 22, 0.25);
    transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn-leer-destacada:hover {
    background: var(--primary-light, #3D6A20);
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(45, 80, 22, 0.35);
  }

  .btn-leer-destacada .arrow-icon {
    transition: transform 0.2s ease;
  }

  .btn-leer-destacada:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* ── Encabezado de Gacetas Secundarias ── */
  .noticias-secundarias-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 2.75rem 0 1.5rem;
    border-top: 1px solid var(--border);
    padding-top: 1.75rem;
  }

  .secundarias-header-left {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .secundarias-icon {
    font-size: 1.35rem;
  }

  .secundarias-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text);
    margin: 0;
  }

  .secundarias-count {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-alt);
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .noticias-secundarias-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('busqueda-noticias') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('#filtros-categorias .filtro-btn');
    const allCards = document.querySelectorAll<HTMLElement>('.noticia-card');
    const secundariasHeader = document.querySelector<HTMLElement>('.noticias-secundarias-header');
    const emptyState = document.getElementById('noticias-vacio');
    const resetBtn = document.getElementById('reset-filtros-btn');

    let currentCategory = 'todos';
    let searchQuery = '';

    function filterItems() {
      let totalVisible = 0;
      let secundariasVisible = 0;

      allCards.forEach(card => {
        const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
        const summary = card.querySelector('p')?.textContent?.toLowerCase() || '';
        const cardCat = card.getAttribute('data-category') || '';

        const matchesCategory = currentCategory === 'todos' || cardCat === currentCategory;
        const matchesSearch = !searchQuery || title.includes(searchQuery) || summary.includes(searchQuery);

        if (matchesCategory && matchesSearch) {
          card.style.display = card.classList.contains('noticia-card-principal') ? 'flex' : 'flex';
          totalVisible++;
          if (!card.classList.contains('noticia-card-principal')) {
            secundariasVisible++;
          }
        } else {
          card.style.display = 'none';
        }
      });

      if (secundariasHeader) {
        secundariasHeader.style.display = secundariasVisible > 0 ? 'flex' : 'none';
      }

      if (emptyState) {
        emptyState.style.display = totalVisible === 0 ? 'block' : 'none';
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase().trim();
      filterItems();
    });

    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        currentCategory = btn.getAttribute('data-category') || 'todos';
        filterItems();
      });
    });

    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      currentCategory = 'todos';
      filterButtons.forEach(b => {
        b.classList.toggle('active', b.getAttribute('data-category') === 'todos');
      });
      filterItems();
    });
  });
</script>

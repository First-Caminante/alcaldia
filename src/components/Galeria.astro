---
import type { GaleriaImagen } from '../types/database';

interface Props {
  imagenes?: GaleriaImagen[];
}

const { imagenes = [] } = Astro.props;

const defaultImages = [
  {
    title: 'Cumbres Nevadas de Apolobamba',
    url: 'https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=800&q=80',
    alt: 'Cumbres nevadas de la cordillera de Apolobamba',
    category: 'paisaje'
  },
  {
    title: 'Valles y Praderas de Alta Montaña',
    url: 'https://images.unsplash.com/photo-1501854140801-50d01698950b?w=800&q=80',
    alt: 'Valles verdes de altura en Pelechuco',
    category: 'paisaje'
  },
  {
    title: 'Tradición Alpaquera y Camélida',
    url: 'https://images.unsplash.com/photo-1504280390367-361c6d9f38f4?w=800&q=80',
    alt: 'Alpacas pastando en bofedales andinos',
    category: 'fauna'
  },
  {
    title: 'Caminos y Rutas de Integración',
    url: 'https://images.unsplash.com/photo-1531804065854-c7b4f00e6b82?w=800&q=80',
    alt: 'Caminos de herradura y carreteras vecinales',
    category: 'obras'
  },
  {
    title: 'Textilería y Arte Kallawaya',
    url: 'https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?w=800&q=80',
    alt: 'Textiles en fibra virgen de vicuña y alpaca',
    category: 'cultura'
  }
];

const items = imagenes.length > 0 ? imagenes.map(img => ({
  title: img.title,
  url: img.image_url,
  alt: img.alt_text || img.title,
  category: img.category || 'paisaje'
})) : defaultImages;

// Duplicamos la lista para crear un ciclo infinito continuo perfecto (seamless loop)
const loopItems = [...items, ...items];
---

<section id="galeria" aria-labelledby="galeria-titulo" style="padding: 4.5rem 0 3.5rem 0; overflow: hidden; position: relative;">
  <div style="max-width: 1200px; margin: 0 auto; padding: 0 1.5rem 1.75rem 1.5rem; text-align: center;">
    <p class="p02-section-label" style="text-transform: uppercase; letter-spacing: 0.12em; font-size: 0.75rem; color: var(--accent); font-weight: 700; margin-bottom: 0.35rem;">
      Patrimonio Visual y Paisajes
    </p>
    <h2 class="p02-section-title" id="galeria-titulo" style="font-family: 'Playfair Display', serif; font-size: 2.2rem; color: var(--primary); margin: 0 0 0.5rem 0;">
      Galería Fotográfica Municipal
    </h2>
    <div class="p02-section-title-deco" aria-hidden="true" style="width: 60px; height: 3px; background: var(--accent); margin: 0 auto 1rem auto; border-radius: 2px;"></div>
    <p style="color: var(--text-muted); max-width: 650px; margin: 0 auto 1.25rem auto; font-size: 0.95rem; line-height: 1.6;">
      Recorrido continuo por las cumbres de Apolobamba, crianza de camélidos andinos, ferias de textilería y vida comunitaria en los ayllus de Pelechuco.
    </p>

    <!-- Botón de control de animación para accesibilidad (WCAG / Reduced Motion) -->
    <div style="display: flex; justify-content: center; align-items: center; gap: 0.75rem; margin-bottom: 0.5rem;">
      <button
        id="btn-toggle-galeria-motion"
        class="filtro-btn"
        type="button"
        aria-pressed="false"
        style="font-size: 0.775rem; padding: 0.35rem 0.8rem; border-radius: 20px; display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; user-select: none;"
        title="Pausar o reanudar desplazamiento continuo"
      >
        <span id="motion-icon" aria-hidden="true">⏸️</span>
        <span id="motion-text">Pausar desplazamiento</span>
      </button>
    </div>
  </div>

  <!-- Contenedor Marquee con gradiente de desvanecimiento lateral -->
  <div class="galeria-marquee-wrapper" id="galeria-marquee-container" aria-label="Galería interactiva en desplazamiento continuo de derecha a izquierda">
    <div class="galeria-marquee-track" id="galeria-track">
      {loopItems.map((item, idx) => (
        <article
          class="galeria-item-card"
          data-index={idx}
          data-title={item.title}
          data-url={item.url}
          data-alt={item.alt}
          data-category={item.category}
          tabindex="0"
          role="button"
          aria-label={`Ver imagen ampliada: ${item.title}`}
        >
          <div class="galeria-img-box">
            <img
              src={item.url}
              alt={item.alt}
              loading="lazy"
              draggable="false"
            />
            <div class="galeria-card-overlay">
              <span class="galeria-badge">{item.category}</span>
              <h4 class="galeria-item-title">{item.title}</h4>
              <span class="galeria-zoom-hint">🔍 Clic para ampliar</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Modal Lightbox para visualización en alta resolución -->
  <dialog id="galeria-lightbox" class="galeria-dialog" aria-modal="true">
    <div class="galeria-lightbox-inner">
      <button id="btn-close-lightbox" class="lightbox-close-btn" aria-label="Cerrar vista ampliada">✕</button>
      <img id="lightbox-img" src="" alt="" />
      <div class="lightbox-caption">
        <span id="lightbox-badge" class="galeria-badge"></span>
        <h3 id="lightbox-title"></h3>
      </div>
    </div>
  </dialog>
</section>

<style>
  /* Envoltorio del marquee con máscara de bordes suaves */
  .galeria-marquee-wrapper {
    position: relative;
    width: 100vw;
    margin-left: calc(-50vw + 50%);
    overflow-x: hidden;
    overflow-y: hidden;
    padding: 0.75rem 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  /* Riel animado continuo de derecha a izquierda */
  .galeria-marquee-track {
    display: flex;
    gap: 1.25rem;
    width: max-content;
    will-change: transform;
    animation: marquee-rtl 38s linear infinite;
  }

  /* Pausa suave al pasar el cursor o hacer focus */
  .galeria-marquee-wrapper:hover .galeria-marquee-track,
  .galeria-marquee-track.is-paused {
    animation-play-state: paused !important;
  }

  @keyframes marquee-rtl {
    0% {
      transform: translate3d(0, 0, 0);
    }
    100% {
      transform: translate3d(-50%, 0, 0);
    }
  }

  /* Tarjeta de imagen individual */
  .galeria-item-card {
    position: relative;
    flex: 0 0 250px;
    height: 175px;
    border-radius: 10px;
    overflow: hidden;
    background: #0f172a;
    border: 1px solid var(--border);
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.2, 0, 0, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }

  .galeria-item-card:hover,
  .galeria-item-card:focus-visible {
    transform: translateY(-6px) scale(1.02);
    box-shadow: 0 16px 30px rgba(0, 0, 0, 0.18);
    border-color: var(--primary);
    outline: none;
    z-index: 10;
  }

  .galeria-img-box {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .galeria-img-box img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }

  .galeria-item-card:hover .galeria-img-box img {
    transform: scale(1.08);
  }

  /* Capa flotante con información */
  .galeria-card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.88) 0%, rgba(15, 23, 42, 0.25) 55%, transparent 100%);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    opacity: 0.92;
    transition: opacity 0.3s ease;
  }

  .galeria-item-card:hover .galeria-card-overlay {
    opacity: 1;
  }

  .galeria-badge {
    align-self: flex-start;
    background: rgba(45, 80, 22, 0.9);
    backdrop-filter: blur(4px);
    color: #FAF7F2;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.2rem 0.55rem;
    border-radius: 20px;
    margin-bottom: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
  }

  .galeria-item-title {
    font-family: 'Playfair Display', serif;
    font-size: 1rem;
    font-weight: 700;
    margin: 0 0 0.2rem 0;
    color: #FAF7F2;
    line-height: 1.25;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.6);
  }

  .galeria-zoom-hint {
    font-size: 0.72rem;
    color: var(--accent-light, #DFCABA);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }

  .galeria-item-card:hover .galeria-zoom-hint {
    opacity: 1;
    transform: translateY(0);
  }

  /* Modal Lightbox */
  .galeria-dialog {
    padding: 0;
    border: none;
    border-radius: 12px;
    background: transparent;
    max-width: 90vw;
    max-height: 90vh;
  }

  .galeria-dialog::backdrop {
    background: rgba(10, 15, 10, 0.85);
    backdrop-filter: blur(6px);
  }

  .galeria-lightbox-inner {
    position: relative;
    background: #0f172a;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.6);
  }

  .lightbox-close-btn {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 1.1rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s ease;
    z-index: 10;
  }

  .lightbox-close-btn:hover {
    background: #dc2626;
  }

  #lightbox-img {
    max-width: 85vw;
    max-height: 75vh;
    object-fit: contain;
    display: block;
  }

  .lightbox-caption {
    padding: 1rem 1.25rem;
    background: #111b27;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .lightbox-caption h3 {
    margin: 0;
    font-size: 1.1rem;
    font-family: 'Playfair Display', serif;
    color: #FAF7F2;
  }

  /* Cumplimiento estricto con prefers-reduced-motion */
  @media (prefers-reduced-motion: reduce) {
    .galeria-marquee-track {
      animation: none !important;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
    }
    .galeria-item-card {
      scroll-snap-align: start;
    }
    #btn-toggle-galeria-motion {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .galeria-item-card {
      flex: 0 0 200px;
      height: 140px;
    }
    .galeria-item-title {
      font-size: 0.8rem;
    }
  }
</style>

<script>
  function initGaleriaMarquee() {
    const track = document.getElementById('galeria-track');
    const toggleBtn = document.getElementById('btn-toggle-galeria-motion');
    const motionIcon = document.getElementById('motion-icon');
    const motionText = document.getElementById('motion-text');

    const dialog = document.getElementById('galeria-lightbox') as HTMLDialogElement | null;
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxBadge = document.getElementById('lightbox-badge');
    const closeBtn = document.getElementById('btn-close-lightbox');

    // Botón para pausar o reanudar desplazamiento
    let isPaused = false;
    toggleBtn?.addEventListener('click', () => {
      isPaused = !isPaused;
      if (track) track.classList.toggle('is-paused', isPaused);
      toggleBtn.setAttribute('aria-pressed', String(isPaused));
      if (motionIcon) motionIcon.textContent = isPaused ? '▶️' : '⏸️';
      if (motionText) motionText.textContent = isPaused ? 'Reanudar movimiento' : 'Pausar desplazamiento';
    });

    // Lightbox al hacer clic en cualquier tarjeta
    document.querySelectorAll('.galeria-item-card').forEach((card) => {
      card.addEventListener('click', () => {
        const url = card.getAttribute('data-url');
        const title = card.getAttribute('data-title');
        const alt = card.getAttribute('data-alt');
        const category = card.getAttribute('data-category');

        if (dialog && lightboxImg && url) {
          lightboxImg.src = url;
          lightboxImg.alt = alt || title || '';
          if (lightboxTitle) lightboxTitle.textContent = title || '';
          if (lightboxBadge) lightboxBadge.textContent = category || 'paisaje';
          dialog.showModal();
        }
      });

      // Soporte teclado (Enter o Espacio)
      card.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (card as HTMLElement).click();
        }
      });
    });

    closeBtn?.addEventListener('click', () => dialog?.close());

    dialog?.addEventListener('click', (e) => {
      const rect = dialog.getBoundingClientRect();
      const isInDialog = (
        rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
        rect.left <= e.clientX && e.clientX <= rect.left + rect.width
      );
      if (!isInDialog) dialog.close();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGaleriaMarquee);
  } else {
    initGaleriaMarquee();
  }
</script>

---
import type { ContactoConfig, RedSocial } from '../types/database';
import { DEFAULT_REDES } from '../lib/data-defaults';

interface Props {
  contacto?: Partial<ContactoConfig>;
  redes?: RedSocial[];
}

const { contacto = {}, redes = [] } = Astro.props;

const address = contacto.address_primary || 'Plaza Principal 25 de Mayo s/n · Acera Norte';
const phone = contacto.phone_central || '(+591) 2 214-5890';
const whatsapp = contacto.phone_whatsapp || '(+591) 715-84210';
const emailGeneral = contacto.email_general || 'contacto@pelechuco.gob.bo';
const schedule = contacto.schedule_weekdays || 'Lun a Vie: 08:30 – 16:30 (Continuo)';
const year = new Date().getFullYear();

const redesActivas = (redes && redes.length > 0)
  ? redes.filter(r => r.is_active !== false)
  : DEFAULT_REDES;
---

<footer class="p02-footer" role="contentinfo">
  <!-- Contenido principal del footer (4 columnas) -->
  <div class="p02-footer-main">

    <!-- Columna 1: Identidad y Escudo -->
    <div>
      <div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:0.75rem;">
        <img
          src="/assets/images/escudo-pelechuco.svg"
          alt="Escudo oficial del Gobierno Autónomo Municipal de Pelechuco"
          style="width:42px;height:48px;object-fit:contain;"
        />
        <div>
          <span class="p02-footer-logo" style="margin-bottom:0.1rem;display:block;">GAM Pelechuco</span>
          <span style="font-size:0.72rem;letter-spacing:0.06em;text-transform:uppercase;color:var(--accent);display:block;font-weight:700;">
            Gobierno Autónomo Municipal
          </span>
        </div>
      </div>
      <p class="p02-footer-desc">
        Gobierno Autónomo Municipal de Pelechuco — Provincia Franz Tamayo, Departamento de La Paz, Estado Plurinacional de Bolivia. Gestión territorial, desarrollo sostenible y preservación de la textilería de camélidos.
      </p>

      <!-- Iconos dinámicos de redes sociales oficiales -->
      <div style="display:flex;align-items:center;gap:0.6rem;margin-top:1.25rem;flex-wrap:wrap;">
        {redesActivas.map(r => {
          const plat = (r.platform || r.icon_name || '').toLowerCase();
          return (
            <a
              href={r.url}
              target="_blank"
              rel="noopener noreferrer"
              class={`p02-social-btn social-${plat}`}
              title={r.name || r.platform}
              aria-label={r.name || r.platform}
            >
              {plat.includes('face') ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              ) : plat.includes('what') ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
              ) : plat.includes('yout') ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              ) : plat.includes('tik') ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.24 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07z"/></svg>
              ) : (plat.includes('twit') || plat.includes('x')) ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              ) : plat.includes('insta') ? (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              ) : (
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
              )}
            </a>
          );
        })}
      </div>
    </div>

    <!-- Columna 2: Navegación del Portal -->
    <div>
      <h4 class="p02-footer-heading">Navegación</h4>
      <ul class="p02-footer-links">
        <li><a href="/#inicio">Inicio</a></li>
        <li><a href="/#conoce">Conoce Pelechuco</a></li>
        <li><a href="/#noticias">Noticias y Avisos</a></li>
        <li><a href="/#autoridades">Autoridades del Municipio</a></li>
        <li><a href="/#tramites">Guía de Trámites</a></li>
        <li><a href="/#contacto">Contacto y Ubicación</a></li>
      </ul>
    </div>

    <!-- Columna 3: Trámites y Transparencia -->
    <div>
      <h4 class="p02-footer-heading">Transparencia</h4>
      <ul class="p02-footer-links">
        <li><a href="/#noticias">Gaceta Municipal Oficial</a></li>
        <li><a href="/#tramites">Transparencia y SICOES</a></li>
        <li><a href="/#contacto">Rendición Pública de Cuentas</a></li>
        <li><a href="/#tramites">Catastro y Obras Públicas</a></li>
        <li><a href="/admin">Gestión de Contenidos</a></li>
      </ul>
    </div>

    <!-- Columna 4: Atención Ciudadana y Enlace Admin -->
    <div>
      <h4 class="p02-footer-heading">Atención Ciudadana</h4>
      <ul class="p02-footer-links" style="font-size:0.84rem;line-height:1.75;">
        <li>📍 {address}</li>
        <li>📞 Central: {phone}</li>
        <li>📱 WhatsApp: {whatsapp}</li>
        <li>✉️ {emailGeneral}</li>
        <li>🕐 {schedule}</li>
      </ul>
      <div style="margin-top:1.25rem;">
        <a href="/admin" class="p02-admin-tag">
          ⚙️ Panel Administrativo
        </a>
      </div>
    </div>
  </div>

  <!-- Barra inferior -->
  <div class="p02-footer-bottom">
    <p>© {year} Gobierno Autónomo Municipal de Pelechuco · Provincia Franz Tamayo, Departamento de La Paz, Bolivia</p>
    <div class="p02-footer-bottom-links">
      <a href="https://facebook.com/GAMPelechuco" target="_blank" rel="noopener noreferrer">Facebook</a>
      <span class="sep">·</span>
      <a href="https://wa.me/59171584210" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <span class="sep">·</span>
      <a href="https://youtube.com/@GAMPelechuco" target="_blank" rel="noopener noreferrer">YouTube</a>
      <span class="sep">·</span>
      <a href="/admin" class="p02-admin-tag">Gestión Municipal</a>
    </div>
  </div>
</footer>

# ==============================================================================
# GAM PELECHUCO - VARIABLES DE ENTORNO
# ==============================================================================

# Supabase (Base de datos y Autenticación)
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-secret-key

# Cloudflare R2 (Almacenamiento multimedia y documentos)
R2_ACCOUNT_ID=tu-cloudflare-account-id
R2_ACCESS_KEY_ID=tu-r2-access-key-id
R2_SECRET_ACCESS_KEY=tu-r2-secret-access-key
R2_BUCKET_NAME=pelechuco
R2_PUBLIC_URL=https://r2.pelechuco.gob.bo

# Configuración General
SITE_URL=http://localhost:4321
NODE_ENV=development
